# LLM: ollama (default, GPU) or api (OpenAI-compatible open-weight host)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_NUM_GPU=99

# Optional OpenAI-compatible fallback serving an open-weight model
# LLM_PROVIDER=api
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_MODEL=gemma-2-2b-it

# Optional Snowflake (omit to use data/sample_weather.json)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=WEATHER__ENVIRONMENT
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
