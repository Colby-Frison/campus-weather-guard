# LLM: ollama (default, GPU) or api (OpenAI-compatible open-weight host)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_NUM_GPU=99
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=280
OLLAMA_TIMEOUT=180

# Optional OpenAI-compatible fallback serving an open-weight model
# LLM_PROVIDER=api
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_MODEL=gemma-2-2b-it

# Snowflake trial — Marketplace: Get "Snowflake Public Data (Free)"
# Account locator looks like xy12345 or org-account (no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_PUBLIC_DATA_FREE
SNOWFLAKE_SCHEMA=PUBLIC_DATA_FREE
SNOWFLAKE_ROLE=
